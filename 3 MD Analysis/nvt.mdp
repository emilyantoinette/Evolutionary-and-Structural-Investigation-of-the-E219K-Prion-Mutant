title       = NVT equilibration
integrator  = md
nsteps      = 50000
dt          = 0.002

tcoupl      = V-rescale
tc-grps     = Protein Non-Protein
tau_t       = 0.1     0.1
ref_t       = 300     300

pcoupl      = no

constraints = h-bonds
constraint_algorithm = lincs

cutoff-scheme = Verlet
coulombtype   = PME
rvdw          = 1.0
rcoulomb      = 1.0

pbc = xyz


